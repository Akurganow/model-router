{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!plugins/model-router/hooks/register.js",
			"!plugins/model-router-omp/extension/index.js",
			"!plugins/model-router-openclaw/index.js",
			"!plugins/model-router-hermes/route.mjs",
			"!packages/model-router"
		]
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		},
		"domains": {
			"project": "recommended",
			"types": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["src/utils/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#core/**", "#adapters/**"],
										"message": "A utils/ file imports only other utils/ files, never core/ or an adapter."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/core/**", "!**/__tests__/**"],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "error",
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"fetch": "The core opens no connection of its own: call the Fetch port the caller passes.",
									"setTimeout": "The core sets no timer of its own: call clock.after on the Clock port the caller passes.",
									"clearTimeout": "The core clears no timer of its own: call cancel on the timer that clock.after returned.",
									"globalThis": "The core reaches no global through globalThis: call the port the caller passes.",
									"setInterval": "The core sets no timer of its own: call clock.after on the Clock port the caller passes.",
									"clearInterval": "The core clears no timer of its own: call cancel on the timer that clock.after returned.",
									"WebSocket": "The core opens no connection of its own: call the Fetch port the caller passes.",
									"XMLHttpRequest": "The core opens no connection of its own: call the Fetch port the caller passes.",
									"EventSource": "The core opens no connection of its own: call the Fetch port the caller passes.",
									"global": "The core reaches no global through global: call the port the caller passes.",
									"setImmediate": "The core sets no timer of its own: call clock.after on the Clock port the caller passes.",
									"clearImmediate": "The core clears no timer of its own: call cancel on the timer that clock.after returned."
								}
							}
						},
						"useNodejsImportProtocol": "error"
					}
				}
			}
		},
		{
			"includes": ["src/**", "scripts/**"],
			"plugins": ["./scripts/lint/parent-import.grit"]
		},
		{
			"includes": ["src/core/parts/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["./**", "#*/**", "!./part.ts", "!#utils/**"],
										"message": "A parts/ file imports only ./part.ts and utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/core/providers/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/scoring/**"],
										"message": "A providers/ file imports nothing from scoring/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/core/output/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/scoring/**", "**/decision/**"],
										"message": "An output/ file imports nothing from scoring/ or decision/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/core/scoring/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/decision/**", "**/options/**"],
										"message": "A scoring/ file imports nothing from decision/ or options/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/core/scoring/formats/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"#*/**",
											"!#core/scoring/failure.ts",
											"!#core/scoring/reply.ts",
											"!#core/parts/part.ts",
											"!#core/brief/brief.ts",
											"!#utils/**"
										],
										"message": "A wire format imports only its own folder, scoring/failure.ts, scoring/reply.ts, parts/part.ts, brief/brief.ts and utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/claude/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#adapters/**", "!#adapters/claude/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/omp/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#adapters/**", "!#adapters/omp/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/openclaw/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#adapters/**", "!#adapters/openclaw/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/openclaw/index.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"openclaw": "The bundle entry imports nothing from OpenClaw."
								},
								"patterns": [
									{
										"group": [
											"openclaw/**",
											"#adapters/**",
											"!#adapters/openclaw/**"
										],
										"message": "The bundle entry imports no other adapter and nothing from OpenClaw."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/hermes/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#adapters/**", "!#adapters/hermes/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["scripts/set-version.ts", "scripts/manifests.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"esbuild": "The version writer and the check load no esbuild."
								}
							}
						}
					}
				}
			}
		}
	],
	"plugins": [
		"./scripts/lint/literal-import.grit",
		"./scripts/lint/utils-reexport.grit",
		"./scripts/lint/shared-reason.grit",
		"./scripts/lint/tests-import.grit",
		"./scripts/lint/core-adapter.grit",
		"./scripts/lint/route-imports.grit",
		"./scripts/lint/core-node.grit",
		"./scripts/lint/src-outside.grit"
	]
}
