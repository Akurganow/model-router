{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!plugins/model-router/hooks/register.js",
			"!plugins/model-router-omp/extension/index.js",
			"!plugins/model-router-openclaw/index.js",
			"!plugins/model-router-hermes/route.mjs",
			"!packages/model-router"
		]
	},
	"linter": {
		"rules": { "preset": "recommended" },
		"domains": { "project": "recommended", "types": "recommended" }
	},
	"overrides": [
		{
			"includes": ["src/utils/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/core/**", "**/adapters/**"],
										"message": "A utils/ file imports only other utils/ files, never core/ or an adapter."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/adapters/**"],
										"message": "A core/ file imports no adapter."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/claude/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/omp/**", "**/openclaw/**", "**/hermes/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/omp/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/claude/**", "**/openclaw/**", "**/hermes/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/openclaw/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/claude/**", "**/omp/**", "**/hermes/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/adapters/hermes/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/claude/**", "**/omp/**", "**/openclaw/**"],
										"message": "An adapter imports no other adapter: move shared code to core/ or utils/."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
