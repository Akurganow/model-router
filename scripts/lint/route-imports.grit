language js

// A plugin and not a third nested override: an override sets noRestrictedImports
// for a file and replaces every earlier override of that rule, so one for
// route.ts would repeat the scoring/ ban once more.
// Grit matches the whole node text and does not group an alternation, hence the [\s\S]* around the group.
// JsModuleSource is the specifier of a static import, a bare import and an
// export … from. An import() call holds its argument as an expression.
// TsImportType is an import in a type position: typeof import("…") and
// import("…").X.
or {
	JsModuleSource() as $specifier,
	`import($specifier)`,
	TsImportType() as $specifier
} where {
	$specifier <: r"[\s\S]*/(?:formats/|transport/|makers/|maker-registry\.ts|maker-module\.ts)[\s\S]*",
	$filename <: r".*/src/core/scoring/route\.ts",
	register_diagnostic(span=$specifier, message="route.ts imports no wire format, nothing from transport/, nothing from makers/ and neither maker-registry.ts nor maker-module.ts.", severity="error")
}
