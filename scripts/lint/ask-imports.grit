language js

// A plugin and not an override, for the reason route-imports.grit gives.
// The not clause keeps makers/registry.ts: Grit's regex has no lookahead.
// JsModuleSource is the specifier of a static import, a bare import and an
// export … from. An import() call holds its argument as an expression.
// TsImportType is an import in a type position: typeof import("…") and
// import("…").X.
or {
	JsModuleSource() as $specifier,
	`import($specifier)`,
	TsImportType() as $specifier
} where {
	$specifier <: r"[\s\S]*/makers/[\s\S]*",
	$specifier <: not r"[\s\S]*/makers/registry\.ts[\s\S]*",
	$filename <: r".*/src/core/scoring/ask\.ts",
	register_diagnostic(span=$specifier, message="ask.ts reaches the provider modules only through makers/registry.ts.", severity="error")
}
