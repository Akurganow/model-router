language js

// core-adapter.grit explains why a plugin holds this ban and the three
// specifier forms. A URL such as new URL("../", import.meta.url) is none of them.
// src-outside.grit explains the [^"']* before the quote.
// A ../ segment counts anywhere in the specifier, so ./../ is no way around.
// This plugin holds no path pattern: a pattern reads the absolute path, so a
// checkout below a folder named scripts would report every file. An override
// in biome.json names its folders.
or {
	JsModuleSource() as $specifier,
	`import($specifier)`,
	TsImportType() as $specifier
} where {
	$specifier <: r"[^\"']*[\"'](?:[^\"']*/)?\.\./[\s\S]*",
	register_diagnostic(span=$specifier, message="A specifier holds no ../: a folder of src/ or scripts/ is imported through its alias, and nothing else is imported from a parent folder.", severity="error")
}
