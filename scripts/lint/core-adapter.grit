language js

// A plugin and not an override: an override sets noRestrictedImports for a
// file and replaces every earlier override of that rule, so each core folder
// with its own import ban would switch this ban off.
// JsModuleSource is the specifier of a static import, a bare import and an
// export … from. An import() call holds its argument as an expression.
or {
	JsModuleSource() as $specifier,
	`import($specifier)`
} where {
	$specifier <: r"[\s\S]*/adapters/[\s\S]*",
	$filename <: r".*/src/core/.*",
	register_diagnostic(span=$specifier, message="A core/ file imports no adapter.", severity="error")
}
