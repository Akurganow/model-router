	"efforts": ["low", "medium", "high", "xhigh"],
	"skips": {
		"modelsNotValid": "model-router skipped, models not valid: run setup",
		"keyUnset": "model-router skipped, key unset",
		"subagentModelSet": "model-router skipped, subagent model set",
		"nodeNotFound": "model-router skipped, node not found",
		"timeout": "model-router skipped, timeout",
		"failed": "model-router skipped, failed"
	},
	"slots": {
		"small": {
			"setting": "small_model",
			"pinned": {
				"unset": "model-router L0 small model unset"
			}
		},
		"middle": {
			"setting": "middle_model",
			"pinned": {
				"unset": "model-router L1 middle model unset"
			}
		},
		"large": {
			"setting": "large_model",
			"pinned": {
				"unset": "model-router L2 large model unset"
			}
		}
	},
	"levels": [0, 1, 2],
	"levelSlots": ["small", "middle", "large"],
	"taskParameters": {
		"description": {
			"type": "string",
			"description": "One line that says what this task is. model-router sends it with the goal to the scoring model, which judges the model and effort the child needs."
		},
		"reasoning_effort": {
			"type": "string",
			"enum": ["low", "medium", "high", "xhigh"],
			"description": "Leave it unset unless you re-dispatch a failed task. The child runs at this effort, and model-router still picks its model. A delegation.reasoning_effort in the user's config wins."
		},
		"level": {
			"type": "integer",
			"enum": [0, 1, 2],
			"description": "Leave it unset unless you re-dispatch a failed task. 0 runs the child on the user's small model, 1 on the user's middle model, 2 on the large model, and model-router asks the scoring model nothing. A level whose model is not set runs on the model Hermes gives it. A routed task's label shows its level as L0, L1 or L2. A model in the user's delegation config wins."
		}
	},
	"delegationAddendum": "When model-router routes a subagent, it picks the model from this brief. Say what is already decided. If nothing is left to decide, say that nothing is; otherwise name what you leave to the subagent. Give every task a description. Leave reasoning_effort and level unset unless you re-dispatch a failed task; the model-router-hermes:model-router skill says how.",
	"backend": "model-router",
	"texts": {
		"toolName": "model_router_config",
		"toolset": "model_router",
		"toolLabel": "Model Router settings",
		"toolDescription": "Reads the router's settings. It returns the provider, the gateway, the three models, and whether each key the settings allow is set. It changes nothing and never returns a key.",
