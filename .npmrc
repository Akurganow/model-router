# A version becomes installable 14 days after it is published. A version
# planted by a compromised maintainer account is usually pulled sooner.
# npm ci installs the lockfile as it is, so the window gates npm install
# and npm update, the commands that resolve new versions. Dependabot has
# the same window in .github/dependabot.yml.
min-release-age=14
# No package runs code at install time.
ignore-scripts=true
save-exact=true
