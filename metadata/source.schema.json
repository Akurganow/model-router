{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Model Router metadata source",
	"description": "Every fact that two or more generated manifests and catalogues repeat, and the facts only one harness needs. Value lists come from src/ at build time and are not stored here.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"name",
		"version",
		"license",
		"homepage",
		"repository",
		"author",
		"keywords",
		"privacyPolicyUrls",
		"descriptions",
		"options",
		"claude",
		"omp",
		"openclaw",
		"hermes",
		"npm"
	],
	"properties": {
		"$schema": { "type": "string" },
		"name": { "$ref": "#/$defs/text" },
		"version": { "$ref": "#/$defs/version" },
		"license": { "$ref": "#/$defs/text" },
		"homepage": { "$ref": "#/$defs/url" },
		"repository": { "$ref": "#/$defs/url" },
		"author": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "url"],
			"properties": {
				"name": { "$ref": "#/$defs/text" },
				"url": { "$ref": "#/$defs/url" }
			}
		},
		"keywords": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/text" }
		},
		"privacyPolicyUrls": { "$ref": "#/$defs/urlPerHarness" },
		"descriptions": {
			"type": "object",
			"additionalProperties": false,
			"required": ["claude", "omp", "openclaw", "hermes"],
			"properties": {
				"claude": { "$ref": "#/$defs/harnessDescriptions" },
				"omp": { "$ref": "#/$defs/harnessDescriptions" },
				"openclaw": { "$ref": "#/$defs/manifestDescription" },
				"hermes": { "$ref": "#/$defs/manifestDescription" }
			}
		},
		"options": {
			"type": "object",
			"additionalProperties": false,
			"required": ["provider", "scope"],
			"properties": {
				"provider": { "$ref": "#/$defs/providerOption" },
				"scope": { "$ref": "#/$defs/option" }
			}
		},
		"claude": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"skills",
				"commandContents",
				"userConfig",
				"catalogueSource",
				"install"
			],
			"properties": {
				"skills": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/text" }
				},
				"commandContents": {
					"type": "object",
					"additionalProperties": false,
					"required": ["provider", "scope"],
					"properties": {
						"provider": { "$ref": "#/$defs/text" },
						"scope": { "$ref": "#/$defs/text" }
					}
				},
				"userConfig": {
					"type": "object",
					"additionalProperties": false,
					"required": ["optionType", "keys"],
					"properties": {
						"optionType": { "$ref": "#/$defs/text" },
						"keys": {
							"type": "object",
							"additionalProperties": false,
							"required": ["api_key", "openrouter_api_key"],
							"properties": {
								"api_key": { "$ref": "#/$defs/secret" },
								"openrouter_api_key": { "$ref": "#/$defs/secret" }
							}
						}
					}
				},
				"catalogueSource": { "$ref": "#/$defs/text" },
				"install": { "$ref": "#/$defs/install" }
			}
		},
		"omp": {
			"type": "object",
			"additionalProperties": false,
			"required": ["package", "settingType", "catalogueSource", "install"],
			"properties": {
				"package": {
					"type": "object",
					"additionalProperties": false,
					"required": ["name", "private", "type", "extensions"],
					"properties": {
						"name": { "$ref": "#/$defs/text" },
						"private": { "type": "boolean" },
						"type": { "$ref": "#/$defs/text" },
						"extensions": {
							"type": "array",
							"minItems": 1,
							"items": { "$ref": "#/$defs/text" }
						}
					}
				},
				"settingType": { "$ref": "#/$defs/text" },
				"catalogueSource": { "$ref": "#/$defs/text" },
				"install": { "$ref": "#/$defs/install" }
			}
		},
		"openclaw": {
			"type": "object",
			"description": "What only the OpenClaw manifest and the npm tree's OpenClaw blocks need. hostFloor is the one OpenClaw version behind compat, build and install.minHostVersion.",
			"additionalProperties": false,
			"required": [
				"pluginId",
				"name",
				"settingType",
				"extensions",
				"skills",
				"hostFloor",
				"uiHints",
				"install"
			],
			"properties": {
				"pluginId": { "$ref": "#/$defs/text" },
				"name": { "$ref": "#/$defs/text" },
				"settingType": { "$ref": "#/$defs/text" },
				"extensions": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/text" }
				},
				"skills": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/text" }
				},
				"hostFloor": { "$ref": "#/$defs/version" },
				"uiHints": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"small_model",
						"large_model",
						"api_key",
						"openrouter_api_key"
					],
					"properties": {
						"small_model": { "$ref": "#/$defs/hint" },
						"large_model": { "$ref": "#/$defs/hint" },
						"api_key": { "$ref": "#/$defs/secretHint" },
						"openrouter_api_key": { "$ref": "#/$defs/secretHint" }
					}
				},
				"install": { "$ref": "#/$defs/install" }
			}
		},
		"hermes": {
			"type": "object",
			"description": "What only the Hermes plugin manifest and the README install region need. Hermes has no scope setting.",
			"additionalProperties": false,
			"required": [
				"pluginName",
				"backendName",
				"requiresHermes",
				"settings",
				"install"
			],
			"properties": {
				"pluginName": { "$ref": "#/$defs/text" },
				"backendName": { "$ref": "#/$defs/text" },
				"requiresHermes": { "$ref": "#/$defs/text" },
				"settings": {
					"type": "object",
					"additionalProperties": false,
					"required": ["small_model", "large_model", "typesafe_api_key"],
					"properties": {
						"small_model": { "$ref": "#/$defs/hint" },
						"large_model": { "$ref": "#/$defs/hint" },
						"typesafe_api_key": { "$ref": "#/$defs/hint" }
					}
				},
				"install": { "$ref": "#/$defs/install" }
			}
		},
		"npm": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"name",
				"private",
				"type",
				"description",
				"keywords",
				"publishConfig"
			],
			"properties": {
				"name": { "$ref": "#/$defs/text" },
				"private": { "type": "boolean" },
				"type": { "$ref": "#/$defs/text" },
				"description": { "$ref": "#/$defs/text" },
				"keywords": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/text" }
				},
				"publishConfig": {
					"type": "object",
					"additionalProperties": false,
					"required": ["access"],
					"properties": { "access": { "$ref": "#/$defs/text" } }
				}
			}
		}
	},
	"$defs": {
		"text": { "type": "string", "minLength": 1 },
		"url": { "type": "string", "pattern": "^https://" },
		"version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
		"urlPerHarness": {
			"type": "object",
			"additionalProperties": false,
			"required": ["claude", "omp", "openclaw", "hermes"],
			"properties": {
				"claude": { "$ref": "#/$defs/url" },
				"omp": { "$ref": "#/$defs/url" },
				"openclaw": { "$ref": "#/$defs/url" },
				"hermes": { "$ref": "#/$defs/url" }
			}
		},
		"manifestDescription": {
			"type": "object",
			"description": "A harness whose store lists no catalogue entry needs the manifest text only.",
			"additionalProperties": false,
			"required": ["manifest"],
			"properties": { "manifest": { "$ref": "#/$defs/text" } }
		},
		"hint": {
			"type": "object",
			"description": "A config field's label and help text in a harness settings form.",
			"additionalProperties": false,
			"required": ["label", "help"],
			"properties": {
				"label": { "$ref": "#/$defs/text" },
				"help": { "$ref": "#/$defs/text" }
			}
		},
		"secretHint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "help", "sensitive"],
			"properties": {
				"label": { "$ref": "#/$defs/text" },
				"help": { "$ref": "#/$defs/text" },
				"sensitive": { "type": "boolean" }
			}
		},
		"harnessDescriptions": {
			"type": "object",
			"additionalProperties": false,
			"required": ["manifest", "catalogue"],
			"properties": {
				"manifest": { "$ref": "#/$defs/text" },
				"catalogue": { "$ref": "#/$defs/text" }
			}
		},
		"option": {
			"type": "object",
			"additionalProperties": false,
			"required": ["default", "title", "descriptions"],
			"properties": {
				"default": { "$ref": "#/$defs/text" },
				"title": { "$ref": "#/$defs/text" },
				"descriptions": {
					"type": "object",
					"additionalProperties": false,
					"required": ["claude", "omp", "openclaw"],
					"properties": {
						"claude": { "$ref": "#/$defs/text" },
						"omp": { "$ref": "#/$defs/text" },
						"openclaw": { "$ref": "#/$defs/text" }
					}
				}
			}
		},
		"providerOption": {
			"type": "object",
			"description": "The provider option, which Hermes also offers. Hermes has no scope option.",
			"additionalProperties": false,
			"required": ["default", "title", "descriptions"],
			"properties": {
				"default": { "$ref": "#/$defs/text" },
				"title": { "$ref": "#/$defs/text" },
				"descriptions": {
					"type": "object",
					"additionalProperties": false,
					"required": ["claude", "omp", "openclaw", "hermes"],
					"properties": {
						"claude": { "$ref": "#/$defs/text" },
						"omp": { "$ref": "#/$defs/text" },
						"openclaw": { "$ref": "#/$defs/text" },
						"hermes": { "$ref": "#/$defs/text" }
					}
				}
			}
		},
		"install": {
			"type": "object",
			"description": "What the README install region shows for one harness. A command or a note holds {marketplace}, {plugin}, {package}, {id}, {hermes} and {backend}, which the builder fills from repository, name, the catalogue name, the npm name, the OpenClaw plugin id, the Hermes plugin name and the Hermes backend name. An empty ciSystems list renders as a harness that CI does not install. ciLine replaces the generated CI sentence, for a harness whose CI install differs from a user's; ciSystems still names the runners that the CI check ties to the workflow.",
			"additionalProperties": false,
			"required": ["heading", "commands", "source", "ciSystems"],
			"properties": {
				"heading": { "$ref": "#/$defs/text" },
				"commands": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/text" }
				},
				"source": {
					"type": "object",
					"additionalProperties": false,
					"required": ["publisher", "title", "url"],
					"properties": {
						"publisher": { "$ref": "#/$defs/text" },
						"title": { "$ref": "#/$defs/text" },
						"url": { "$ref": "#/$defs/url" }
					}
				},
				"ciSystems": {
					"type": "array",
					"items": { "$ref": "#/$defs/text" }
				},
				"ciLine": { "$ref": "#/$defs/text" },
				"note": { "$ref": "#/$defs/text" }
			}
		},
		"secret": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "title", "description", "sensitive"],
			"properties": {
				"type": { "$ref": "#/$defs/text" },
				"title": { "$ref": "#/$defs/text" },
				"description": { "$ref": "#/$defs/text" },
				"sensitive": { "type": "boolean" }
			}
		}
	}
}
