{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Model Router metadata source",
	"description": "Every fact that two or more generated manifests and catalogues repeat, and the facts only one harness needs. Value lists come from src/ at build time and are not stored here.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"name",
		"version",
		"license",
		"homepage",
		"repository",
		"author",
		"keywords",
		"privacyPolicyUrls",
		"descriptions",
		"options",
		"claude",
		"omp"
	],
	"properties": {
		"$schema": { "type": "string" },
		"name": { "$ref": "#/$defs/text" },
		"version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
		"license": { "$ref": "#/$defs/text" },
		"homepage": { "$ref": "#/$defs/url" },
		"repository": { "$ref": "#/$defs/url" },
		"author": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "url"],
			"properties": {
				"name": { "$ref": "#/$defs/text" },
				"url": { "$ref": "#/$defs/url" }
			}
		},
		"keywords": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/text" }
		},
		"privacyPolicyUrls": { "$ref": "#/$defs/urlPerHarness" },
		"descriptions": {
			"type": "object",
			"additionalProperties": false,
			"required": ["claude", "omp"],
			"properties": {
				"claude": { "$ref": "#/$defs/harnessDescriptions" },
				"omp": { "$ref": "#/$defs/harnessDescriptions" }
			}
		},
		"options": {
			"type": "object",
			"additionalProperties": false,
			"required": ["provider", "scope"],
			"properties": {
				"provider": { "$ref": "#/$defs/option" },
				"scope": { "$ref": "#/$defs/option" }
			}
		},
		"claude": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"skills",
				"commandContents",
				"userConfig",
				"catalogueSource"
			],
			"properties": {
				"skills": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/text" }
				},
				"commandContents": {
					"type": "object",
					"additionalProperties": false,
					"required": ["provider", "scope"],
					"properties": {
						"provider": { "$ref": "#/$defs/text" },
						"scope": { "$ref": "#/$defs/text" }
					}
				},
				"userConfig": {
					"type": "object",
					"additionalProperties": false,
					"required": ["optionType", "keys"],
					"properties": {
						"optionType": { "$ref": "#/$defs/text" },
						"keys": {
							"type": "object",
							"additionalProperties": false,
							"required": ["api_key", "openrouter_api_key"],
							"properties": {
								"api_key": { "$ref": "#/$defs/secret" },
								"openrouter_api_key": { "$ref": "#/$defs/secret" }
							}
						}
					}
				},
				"catalogueSource": { "$ref": "#/$defs/text" }
			}
		},
		"omp": {
			"type": "object",
			"additionalProperties": false,
			"required": ["package", "settingType", "catalogueSource"],
			"properties": {
				"package": {
					"type": "object",
					"additionalProperties": false,
					"required": ["name", "private", "type", "extensions"],
					"properties": {
						"name": { "$ref": "#/$defs/text" },
						"private": { "type": "boolean" },
						"type": { "$ref": "#/$defs/text" },
						"extensions": {
							"type": "array",
							"minItems": 1,
							"items": { "$ref": "#/$defs/text" }
						}
					}
				},
				"settingType": { "$ref": "#/$defs/text" },
				"catalogueSource": { "$ref": "#/$defs/text" }
			}
		}
	},
	"$defs": {
		"text": { "type": "string", "minLength": 1 },
		"url": { "type": "string", "pattern": "^https://" },
		"urlPerHarness": {
			"type": "object",
			"additionalProperties": false,
			"required": ["claude", "omp"],
			"properties": {
				"claude": { "$ref": "#/$defs/url" },
				"omp": { "$ref": "#/$defs/url" }
			}
		},
		"harnessDescriptions": {
			"type": "object",
			"additionalProperties": false,
			"required": ["manifest", "catalogue"],
			"properties": {
				"manifest": { "$ref": "#/$defs/text" },
				"catalogue": { "$ref": "#/$defs/text" }
			}
		},
		"option": {
			"type": "object",
			"additionalProperties": false,
			"required": ["default", "title", "descriptions"],
			"properties": {
				"default": { "$ref": "#/$defs/text" },
				"title": { "$ref": "#/$defs/text" },
				"descriptions": {
					"type": "object",
					"additionalProperties": false,
					"required": ["claude", "omp"],
					"properties": {
						"claude": { "$ref": "#/$defs/text" },
						"omp": { "$ref": "#/$defs/text" }
					}
				}
			}
		},
		"secret": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "title", "description", "sensitive"],
			"properties": {
				"type": { "$ref": "#/$defs/text" },
				"title": { "$ref": "#/$defs/text" },
				"description": { "$ref": "#/$defs/text" },
				"sensitive": { "type": "boolean" }
			}
		}
	}
}
